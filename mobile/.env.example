# OAuth client IDs for local development builds
# Copy to .env.local (gitignored) or set in EAS → Environment variables

# Firebase Console → Authentication → Google → Web SDK configuration
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Cloud Console → iOS OAuth client for com.acuratls.gathered
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Reversed iOS client ID (URL scheme), e.g. com.googleusercontent.apps.123456789
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
