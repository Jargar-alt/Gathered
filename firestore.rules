rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isGroupMember(groupId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids.hasAny([request.auth.uid]);
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "jrgarber4@gmail.com" && request.auth.token.email_verified == true));
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
    }

    // Groups
    match /groups/{groupId} {
      allow read: if isAuthenticated(); // Allow reading to check invite codes
      allow create: if isAuthenticated();
      allow update: if isGroupMember(groupId) || isAdmin();
    }

    // Reading Entries
    match /readings/{readingId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if isAuthenticated() && isGroupMember(request.resource.data.groupId);
      allow update: if isGroupMember(resource.data.groupId); // Allow reactions
      allow delete: if isOwner(resource.data.uid);
    }

    // Prayer Requests
    match /prayers/{prayerId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if isAuthenticated() && isGroupMember(request.resource.data.groupId);
      allow update: if isGroupMember(resource.data.groupId); // Allow reactions and notes
      allow delete: if isOwner(resource.data.uid);
    }
  }
}
